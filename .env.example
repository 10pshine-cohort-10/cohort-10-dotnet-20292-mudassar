
# --- ASP.NET Core Runtime ---
ASPNETCORE_ENVIRONMENT=Development

# --- Database (SQL Server, opened with SSMS) --------------------------------
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=TaskManagerDb;User Id=YOUR_LOGIN;Password=YOUR_PASSWORD;TrustServerCertificate=True

# --- JWT Authentication Secrets ---
Jwt__Issuer=TaskManager
Jwt__Audience=TaskManagerClient
Jwt__Key=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET_KEY
Jwt__ExpiryMinutes=

# --- Seed Admin Credentials ---
SeedAdmin__Email=
SeedAdmin__FullName=System Admin
SeedAdmin__Password=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# --- Seed Test User Credentials ---
SeedUser__Email=
SeedUser__FullName=Test User
SeedUser__Password=REPLACE_WITH_STRONG_USER_PASSWORD

# --- CORS & Rate Limiting ---
Cors__Origins__0=http://localhost:5173
RateLimiting__AuthPermitLimit=10

# --- Frontend (used when frontend is added) ---
VITE_API_BASE_URL=https://localhost:5001

# --- Code Quality (optional, used in Branch 8) ---
SONAR_TOKEN=

