root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

# ============================================================
# C# (.NET Backend) Formatting & SonarQube / Roslyn Rules
# ============================================================
[*.cs]
indent_style = space
indent_size = 4

# SonarQube C# (SonarAnalyzer.CSharp) Rules
dotnet_diagnostic.S101.severity = warning     # Types should be named in PascalCase
dotnet_diagnostic.S107.severity = warning     # Methods should not have too many parameters
dotnet_diagnostic.S112.severity = warning     # General exceptions should never be thrown
dotnet_diagnostic.S125.severity = warning     # Sections of code should not be commented out
dotnet_diagnostic.S1066.severity = warning    # Collapsible "if" statements should be merged
dotnet_diagnostic.S1118.severity = warning    # Utility classes should not have public constructors
dotnet_diagnostic.S1144.severity = warning    # Unused private types or members should be removed
dotnet_diagnostic.S1172.severity = warning    # Unused method parameters should be removed
dotnet_diagnostic.S1481.severity = warning    # Unused local variables should be removed
dotnet_diagnostic.S1854.severity = warning    # Unused assignments should be removed
dotnet_diagnostic.S2068.severity = error      # Hard-coded credentials are security-sensitive
dotnet_diagnostic.S2259.severity = warning    # Null pointers should not be dereferenced
dotnet_diagnostic.S2589.severity = warning    # Boolean expressions should not be gratuitous
dotnet_diagnostic.S3358.severity = suggestion # Ternary operators should not be nested
dotnet_diagnostic.S3776.severity = warning    # Cognitive Complexity of methods should not be too high
dotnet_diagnostic.S4457.severity = warning    # Parameter validation in async methods should be wrapped

# .NET / Roslyn Code Quality Rules
dotnet_diagnostic.CA1050.severity = none      # Declare types in namespaces (Program.cs uses top-level statements)
dotnet_diagnostic.CA1822.severity = suggestion# Mark members as static when possible
dotnet_diagnostic.CA1848.severity = suggestion# Use LoggerMessage delegates (Serilog structured logging is used)
dotnet_diagnostic.CA1860.severity = warning   # Prefer comparing Count to 0 rather than Any()
dotnet_diagnostic.CA1873.severity = suggestion# Avoid potentially expensive logging arguments
dotnet_diagnostic.CA2016.severity = suggestion# Forward CancellationToken parameter
dotnet_diagnostic.CA2254.severity = warning   # Template should be a static expression in structured logging

# Relax rules in EF Core auto-generated Migrations and xUnit Tests
[Backend/src/TaskManager.Api/Data/Migrations/*.cs]
generated_code = true

[Backend/tests/**/*.cs]
dotnet_diagnostic.S107.severity = none
dotnet_diagnostic.CA1707.severity = none      # Allow underscores in test method names

# ============================================================
# JavaScript / React (Frontend) Formatting & Quality Rules
# ============================================================
[*.{js,jsx,json,css,html}]
indent_style = space
indent_size = 2
