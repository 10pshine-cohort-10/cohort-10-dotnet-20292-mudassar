    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>taskmanager-api-6f1c2b7e-4b8a-4c1e-9d0e-2a7c5b3f9e10</UserSecretsId>
